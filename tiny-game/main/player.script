local function wrap_angle(a)
	while a > math.pi do a = a - 2 * math.pi end
	while a < -math.pi do a = a + 2 * math.pi end
	return a
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.moving = { up=false, down=false, left=false, right=false }
	self.yaw = 0
	self.vy = 0
	self.grounded = true
	self.walk_phase = 0
	self.time = 0
	print("CHIBI WORLD READY")
end

local function set_flag(self, action_id, pressed)
	if action_id == hash("up") then self.moving.up = pressed
	elseif action_id == hash("down") then self.moving.down = pressed
	elseif action_id == hash("left") then self.moving.left = pressed
	elseif action_id == hash("right") then self.moving.right = pressed
	elseif action_id == hash("jump") and pressed and self.grounded then
		self.vy = 5.4
		self.grounded = false
	end
end

function on_input(self, action_id, action)
	if not action_id then return end
	if action.pressed then set_flag(self, action_id, true) end
	if action.released then set_flag(self, action_id, false) end
end

function update(self, dt)
	self.time = self.time + dt
	local pos = go.get_position()
	local yaw = self.yaw
	local mv = self.moving

	-- vertical physics
	if not self.grounded then
		self.vy = self.vy - 14.0 * dt
		pos.y = pos.y + self.vy * dt
		if pos.y <= 0 then
			pos.y = 0
			self.vy = 0
			self.grounded = true
		end
	end

	local moving = mv.up or mv.down or mv.left or mv.right
	local speed = 4.5
	if moving then
		-- local input direction (right-handed, -Z is view forward)
		local ix = (mv.right and 1 or 0) - (mv.left and 1 or 0)
		local iz = (mv.down and 1 or 0) - (mv.up and 1 or 0)
		local l = math.sqrt(ix * ix + iz * iz)
		ix, iz = ix / l, iz / l
		-- rotate world frame by yaw about Y (right-handed R_y)
		local s, c = math.sin(yaw), math.cos(yaw)
		local wx = ix * c + iz * s
		local wz = -ix * s + iz * c
		pos.x = pos.x + wx * speed * dt
		pos.z = pos.z + wz * speed * dt
		pos.x = math.max(-15, math.min(15, pos.x))
		pos.z = math.max(-15, math.min(15, pos.z))
		-- yaw eases toward movement direction (player forward is local -Z)
		local target = math.atan2(-wx, -wz)
		local d = wrap_angle(target - yaw)
		yaw = yaw + d * math.min(1, dt * 8)
	end
	self.yaw = yaw
	go.set_rotation(vmath.quat_rotation_y(yaw))
	go.set_position(pos)

	-- walk cycle + idle
	local rig_pos = go.get_position("rig")
	local bob
	if moving then
		self.walk_phase = self.walk_phase + dt * 2 * math.pi * 1.9
		local s = math.sin(self.walk_phase)
		go.set_rotation(vmath.quat_rotation_x(s * 0.8), "arm_l")
		go.set_rotation(vmath.quat_rotation_x(-s * 0.8), "arm_r")
		go.set_rotation(vmath.quat_rotation_x(-s * 0.9), "leg_l")
		go.set_rotation(vmath.quat_rotation_x(s * 0.9), "leg_r")
		bob = math.abs(math.sin(self.walk_phase)) * 0.09
		go.set_rotation(vmath.quat_rotation_x(math.sin(self.walk_phase * 2) * 0.05), "head")
	else
		go.set_rotation(vmath.quat_rotation_x(0), "arm_l")
		go.set_rotation(vmath.quat_rotation_x(0), "arm_r")
		go.set_rotation(vmath.quat_rotation_x(0), "leg_l")
		go.set_rotation(vmath.quat_rotation_x(0), "leg_r")
		go.set_rotation(vmath.quat_rotation_x(0), "head")
		bob = math.sin(self.time * 2) * 0.03
	end
	rig_pos.y = 0.95 + bob
	go.set_position(rig_pos, "rig")
end

function final(self)
	msg.post(".", "release_input_focus")
end
