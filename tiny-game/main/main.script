local function inside(ellipses, x, z)
	for _, e in ipairs(ellipses) do
		local dx = (x - e[1]) / e[3]
		local dz = (z - e[2]) / e[3]
		if dx * dx + dz * dz < 1 then return true end
	end
	return false
end

function init(self)
	local player_url = collectionfactory.create("#playerfactory", vmath.vector3(0, 0, 6))
	collectionfactory.create("#housefactory", vmath.vector3(0, 0, -7.5))

	-- trees
	do
		local letters = {
			{"pink", -3.6, -4.6, 1.15},
			{"green", 4.3, -3.6, 1.05},
			{"orange", -6.5, 1.5, 1.0},
			{"green", 6.8, -6.8, 1.2},
			{"green", -5.2, 6.4, 1.1},
			{"orange", 3.4, 4.6, 0.95},
			{"green", -9.5, -6.2, 1.25},
			{"pink", 9.8, -2.8, 1.0},
			{"orange", -8.8, 9.2, 1.05},
			{"green", 11.5, 6.5, 1.15},
			{"pink", -2.8, 10.8, 1.0},
			{"green", 7.6, 11.4, 1.05},
		}
		for _, t in ipairs(letters) do
			local fac = "#tree_" .. t[1] .. "_factory"
			local id = collectionfactory.create(fac,
				vmath.vector3(t[2], 0, t[3]), nil, nil, t[4])
		end
	end

	local avoid = {
		{0, 0, 2.2},     -- spawn clearing
		{7, 3, 4.0},     -- pond
		{0, -1, 1.8},    -- path mid
		{0, -4, 2.0},    -- path near house
		{0, -7.5, 3.4},  -- house footprint
		{-3.6, -4.6, 1.6},
	}

	math.randomseed(1234)

	local function scatter(fid, n, smin, smax, allow_y)
		for i = 1, n do
			local x, z, tries = 0, 0, 0
			repeat
				x = (math.random() * 2 - 1) * 14.0
				z = (math.random() * 2 - 1) * 14.0
				tries = tries + 1
			until tries > 40 or not inside(avoid, x, z)
			local pos = vmath.vector3(x, 0, z)
			local rot = vmath.quat_rotation_y(math.random() * math.pi * 2)
			local s = smin + math.random() * (smax - smin)
			collectionfactory.create(fid, pos, rot, nil, s)
		end
	end

	scatter("#grassfactory", 26, 0.8, 1.3)
	scatter("#flower_pink_factory", 5, 1.0, 1.25)
	scatter("#flower_yellow_factory", 5, 1.0, 1.25)
	scatter("#flower_lav_factory", 4, 1.0, 1.25)
	scatter("#rockfactory", 6, 0.7, 1.5)

	-- clouds
	for i = 1, 4 do
		local x = -14 + (i - 1) * 8 + (i % 2) * 2
		local y = 9 + (i * 1.7) % 3.5
		local z = -4 - (i * 3.1) % 6
		collectionfactory.create("#cloudfactory",
			vmath.vector3(x, y, z), nil, nil, 1 + (i % 3) * 0.25)
	end

	print("WORLD SPAWNED: player at (0,0,6), house at (0,0,-7.5)")
end
